# --- Copy this file to ".env" and fill in the values ---

# TallyPrime HTTP-XML server on this PC (Gateway of Tally must be running).
TALLY_URL=http://localhost:9000

# The VChemics backend deployed on Railway.
BACKEND_URL=https://your-backend.up.railway.app

# Must EXACTLY match the backend's SYNC_AGENT_TOKEN.
SYNC_AGENT_TOKEN=paste-the-same-token-as-the-backend

# Exact Tally company name.
COMPANY_NAME=VCHEMICS INDIA SOLUTIONS-2026-2027

# Financial-year start used as the "from" date for a full sync (YYYYMMDD).
FY_START=20260401

# Optional: override the "to" date (defaults to today). YYYYMMDD.
# TO_DATE=20260731
