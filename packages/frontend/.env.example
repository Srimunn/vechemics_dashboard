# Backend API base URL (server-side, used by NextAuth authorize()).
BACKEND_URL=http://localhost:3001

# Backend API base URL exposed to the browser (dashboard fetches).
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Demo mode: when 'true', the dashboard uses bundled mock data and the auth gate
# is skipped — handy for previewing the UI with no backend. Set 'false' in prod.
NEXT_PUBLIC_USE_MOCK=true

# NextAuth session signing secret (must match the backend's NEXTAUTH_SECRET).
NEXTAUTH_SECRET=change-me-to-match-the-backend
AUTH_SECRET=change-me-to-match-the-backend

# Public URL of this frontend.
NEXTAUTH_URL=http://localhost:3000
