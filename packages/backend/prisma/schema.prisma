generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("CEO")
  createdAt    DateTime @default(now())
}

model Company {
  id          String   @id @default(cuid())
  tallyName   String   @unique // "VCHEMICS INDIA SOLUTIONS-2026-2027"
  displayName String
  fyStart     DateTime
  fyEnd       DateTime
  createdAt   DateTime @default(now())

  vouchers      Voucher[]
  ledgers       Ledger[]
  stockItems    StockItem[]
  outstandings  Outstanding[]
  kpiSnapshots  KpiSnapshot[]
  notifications Notification[]
  ledgerBalances LedgerBalance[]
}

model Voucher {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  tallyGuid     String   @unique // Tally's GUID for dedup
  voucherType   String // "Sales", "Purchase", "Receipt", "Payment", "Journal", "Contra"
  voucherNumber String
  date          DateTime
  partyName     String?
  narration     String?
  amount        Decimal  @db.Decimal(18, 2)
  isCancelled   Boolean  @default(false)

  items         VoucherItem[]
  ledgerEntries VoucherLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, date])
  @@index([voucherType, date])
  @@index([partyName])
}

model VoucherItem {
  id            String   @id @default(cuid())
  voucherId     String
  voucher       Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  stockItemName String
  quantity      Decimal  @db.Decimal(18, 4)
  unit          String
  rate          Decimal  @db.Decimal(18, 4)
  amount        Decimal  @db.Decimal(18, 2)
  costRate      Decimal? @db.Decimal(18, 4)
  costAmount    Decimal? @db.Decimal(18, 2)
  profit        Decimal? @db.Decimal(18, 2)
  marginPct     Decimal? @db.Decimal(5, 2)
  gstRate       Decimal? @db.Decimal(5, 2) // e.g. 18.00
  hsnCode       String?

  @@index([stockItemName])
}

model VoucherLedgerEntry {
  id         String  @id @default(cuid())
  voucherId  String
  voucher    Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledgerName String
  amount     Decimal @db.Decimal(18, 2)
  isDebit    Boolean

  @@index([ledgerName])
}

model Ledger {
  id             String  @id @default(cuid())
  companyId      String
  company        Company @relation(fields: [companyId], references: [id])
  name           String
  parentGroup    String // "Sundry Debtors", "Bank Accounts", etc.
  openingBalance Decimal @default(0) @db.Decimal(18, 2)
  currentBalance Decimal @default(0) @db.Decimal(18, 2)
  isDebit        Boolean @default(true)
  gstin          String?
  state          String?

  @@unique([companyId, name])
  @@index([parentGroup])
}

model StockItem {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  unit         String
  hsnCode      String?
  gstRate      Decimal? @db.Decimal(5, 2)
  closingQty   Decimal  @default(0) @db.Decimal(18, 4)
  closingValue Decimal  @default(0) @db.Decimal(18, 2)
  avgCost      Decimal  @default(0) @db.Decimal(18, 4) // weighted average cost per unit

  @@unique([companyId, name])
}

model Outstanding {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  type          String // "receivable" or "payable"
  billDate      DateTime
  billRef       String
  partyName     String
  dueDate       DateTime?
  pendingAmount Decimal   @db.Decimal(18, 2)
  overdueDays   Int       @default(0)

  @@index([companyId, type])
  @@index([partyName])
}

// Pre-computed KPI snapshots — makes dashboard load in <500ms
model KpiSnapshot {
  id                     String   @id @default(cuid())
  companyId              String
  company                Company  @relation(fields: [companyId], references: [id])
  snapshotDate           DateTime // 1 row per day
  todaySales             Decimal  @db.Decimal(18, 2)
  todayPurchase          Decimal  @db.Decimal(18, 2)
  todayGrossProfit       Decimal  @db.Decimal(18, 2)
  todayNetProfit         Decimal  @db.Decimal(18, 2)
  collectionsToday       Decimal  @db.Decimal(18, 2)
  outstandingReceivables Decimal  @db.Decimal(18, 2)
  outstandingPayables    Decimal  @db.Decimal(18, 2)
  cashInHand             Decimal  @db.Decimal(18, 2)
  bankBalance            Decimal  @db.Decimal(18, 2)
  inventoryValue         Decimal  @db.Decimal(18, 2)
  gstPayable             Decimal  @db.Decimal(18, 2)
  mtdSales               Decimal  @db.Decimal(18, 2)
  mtdPurchase            Decimal  @db.Decimal(18, 2)
  ordersBilledToday      Int      @default(0)
  newCustomersToday      Int      @default(0)
  createdAt              DateTime @default(now())

  @@unique([companyId, snapshotDate])
  @@index([snapshotDate])
}

model SyncLog {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  syncType      String // "incremental" | "full" | "manual"
  status        String // "success" | "partial" | "failed"
  recordsSynced Int       @default(0)
  errorMessage  String?

  @@index([startedAt])
}

// On-demand refresh flag: frontend inserts a row via POST /api/sync/trigger;
// the sync agent polls GET /api/sync/pending-trigger, consumes it, runs a sync.
model SyncTrigger {
  id          String    @id @default(cuid())
  requestedAt DateTime  @default(now())
  consumedAt  DateTime?
  syncType    String    @default("manual")

  @@index([consumedAt])
}

model Notification {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  type        String   // "overdue_receivable", "payment_due", "gst_reminder", "low_stock", "negative_margin", "daily_summary"
  title       String
  message     String
  severity    String   // "info", "warning", "critical"
  isRead      Boolean  @default(false)
  relatedId   String?
  relatedUrl  String?
  createdAt   DateTime @default(now())

  @@index([companyId, isRead])
  @@index([createdAt])
}

model LedgerBalance {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  name           String
  parentGroup    String
  closingBalance Decimal  @db.Decimal(18, 2)
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([companyId, name])
  @@index([parentGroup])
}
