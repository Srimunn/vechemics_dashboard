# TallyPrime HTTP-XML server on the Vchemics PC.
TALLY_URL=http://localhost:9000

# Cloud backend base URL (Railway).
BACKEND_URL=https://your-backend.up.railway.app

# Shared secret presented in the X-Sync-Token header. MUST match the backend's
# SYNC_AGENT_TOKEN exactly.
SYNC_AGENT_TOKEN=change-me-to-match-the-backend

# Tally company to export from (exact name as it appears in Tally).
COMPANY_NAME=VCHEMICS INDIA SOLUTIONS-2026-2027

# Financial year start (used as the "from" date for full syncs). YYYYMMDD.
FY_START=20260401

# trace | debug | info | warn | error
LOG_LEVEL=info

# Save each raw Tally XML response under ./samples on every run (helps you
# verify/adjust parsers). Set to false in production.
DEV_SAVE_SAMPLES=true

# Local HTTP port for the on-demand "Refresh Tally Data" trigger endpoint.
LOCAL_TRIGGER_PORT=4001

# How often (seconds) to poll the backend for a pending manual-refresh trigger.
POLL_INTERVAL_SECONDS=30
