# PostgreSQL connection string (Railway provides this in production)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared secret the sync agent presents in the X-Sync-Token header.
# Must match the sync agent's SYNC_AGENT_TOKEN. Generate a long random string.
SYNC_AGENT_TOKEN=change-me-to-a-long-random-string

# NextAuth session signing secret (must match the frontend's NEXTAUTH_SECRET).
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Initial CEO password used by prisma/seed.ts on first deploy. Remove after seeding.
INITIAL_CEO_PASSWORD=change-me

# Tally company whose data this backend serves (used to upsert the Company row).
COMPANY_NAME=VCHEMICS INDIA SOLUTIONS-2026-2027

# HTTP port for the Express API.
PORT=3001
